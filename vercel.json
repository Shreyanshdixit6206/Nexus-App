{
  "buildCommand": "cd nexus-webapp && npm run build",
  "devCommand": "cd nexus-webapp && npm run dev",
  "installCommand": "cd nexus-webapp && npm install",
  "outputDirectory": "nexus-webapp/.next",
  "framework": "nextjs",
  "env": {
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key for AI prescription analysis",
      "placeholder": "your_gemini_api_key",
      "required": true
    }
  },
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  }
}
